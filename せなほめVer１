<!doctype html>
<html lang="ja">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f8f3e9">
<title>星南ぬいの小部屋</title>
<style>:root { color-scheme: light; font-family: "Hiragino Maru Gothic ProN", "Yu Gothic", sans-serif; color: #44382e; font-weight: 700; background: #f8f3e9; }
* { box-sizing: border-box; }
body { margin: 0; min-height: 100svh; background: linear-gradient(to bottom, #f8f3e9 0%, #f8f3e9 67%, #dfd0ba 67%, #dfd0ba calc(67% + 2px), #f0e5d5 calc(67% + 2px), #f0e5d5 100%); }
main { position: relative; width: min(100%, 520px); min-height: 100svh; margin: auto; padding: max(32px, env(safe-area-inset-top)) 26px max(30px, env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 26px; }
h1 { margin: 0 0 12px; padding: 0 0 14px; font-size: 18px; font-weight: 800; letter-spacing: .16em; text-align: center; }
h1::after { content: ""; display: block; width: 28px; height: 3px; border-radius: 3px; background: #b5ba9c; margin: 15px auto -14px; }
.bubble { z-index: 2; position: relative; width: min(100%, 390px); min-height: 104px; display: grid; place-items: center; margin: 0; padding: 20px 24px; border: 2px solid #d5c8b6; border-radius: 26px; background: #fffdf7; box-shadow: 0 5px 0 #6a503609; text-align: center; font-size: clamp(17px, 4.5vw, 20px); line-height: 1.8; overflow-wrap: anywhere; }
.bubble::after { content: ""; position: absolute; bottom: -9px; left: calc(50% - 8px); width: 16px; height: 16px; background: #fffdf7; border-right: 2px solid #d5c8b6; border-bottom: 2px solid #d5c8b6; transform: rotate(45deg); }
.room-stage { position: relative; isolation: isolate; width: 100%; display: grid; place-items: center; padding: 0 0 19px; }
.rug { z-index: -1; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: min(100%, 330px); height: 82px; border-radius: 50%; background: #bec3a5; border: 7px solid #d0d3bb; box-shadow: 0 3px 0 #a5aa8e, 0 12px 18px #66553c0d; }
.rug::after { content: ""; position: absolute; inset: 5px 9px; border: 1px solid #e6e8d39c; border-radius: 50%; }
#nui { appearance: none; border: 0; padding: 0; background: transparent; width: 100%; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; transform-origin: center bottom; }
#nui:focus-visible { outline: 3px solid #777f5c; outline-offset: 5px; border-radius: 24px; }
#nui:disabled { cursor: default; }
#photo { display: block; width: auto; max-width: 100%; margin: 0 auto; height: clamp(220px, 40svh, 350px); object-fit: contain; user-select: none; -webkit-user-select: none; }
.hint { margin: 0; font-size: 14px; letter-spacing: .08em; color: #514035; text-align: center; line-height: 1.7; }
@media (max-height: 650px) { main { gap: 18px; padding-top: 22px; padding-bottom: 22px; } h1 { margin-bottom: 0; font-size: 16px; } .bubble { min-height: 86px; padding: 15px 20px; } #photo { height: clamp(170px, 35svh, 240px); } .rug { height: 65px; width: min(100%, 280px); } }
@media (max-width: 350px) { main { padding-left: 18px; padding-right: 18px; } }

.bubble { white-space: pre-line; }
</style>
<main>
  <h1>星南ぬいの小部屋</h1>
  <p class="bubble" id="message" role="status" aria-live="polite">ぬいをタップしてね ♡</p>
  <div class="room-stage">
  <div class="rug" aria-hidden="true"></div>
  <button id="nui" type="button" aria-label="星南ぬいをタップして褒めてもらう" disabled>
    <img id="photo" src="data:image/png;base64," alt="星南ぬい" draggable="false">
  </button>
  </div>
  <p class="hint" id="hint">ぬいをタップしてね ♡</p>
</main>
<script>// 褒め言葉はユーザーの依頼により新規作成。罵倒文言は原文を保持。
window.SENA_LINES = {
  compliments: [
    "きょうもここまで来てえらいわね〜♡",
    "起きただけでも、はなまるよ〜",
    "あなたのペース、いい感じね〜",
    "よく来たわね。なでなでしてあげる♡",
    "きょうのあなたも、かわいいわね〜",
    "ちゃんと休めるあなた、えらいわ〜",
    "小さな一歩も、見逃さないわよ♡",
    "のんびりしてるあなたも、すてきね〜",
    "ごはんを食べたの？ えらいわね〜♡",
    "お水を飲めたら、もうひとつはなまるよ〜",
    "あなたが来ると、ここがぽかぽかするわ〜",
    "きょうもよくやってるわ。もちもち認定よ♡",
    "その調子、その調子。急がなくていいのよ〜",
    "ひと息つけたのね。じょうずだわ〜",
    "あなたのやさしいところ、すてきよ♡",
    "好きなものを大事にできて、えらいわね〜",
    "ここまでがんばったあなたに、はなまる〜♡",
    "眠たいのに起きてるのね。よくやったわ〜",
    "自分の気持ちに気づけたの、えらいわよ〜",
    "ちょっとできた？ それ、ちゃんとすごいのよ♡",
    "何もできない日も、あなたはかわいいわよ〜",
    "会いに来てくれるあなた、だいすきよ♡",
    "ふふ、きょうもいいお顔ね〜",
    "がんばり屋さんね。ここではふにゃっとしていいわよ〜",
    "自分のために時間をつくれて、えらいわ♡",
    "あなたの好きって気持ち、きらきらしてるわね〜",
    "ゆっくりでも進んでるの、ちゃんとえらいわよ〜",
    "きょうを過ごしたあなたに、特大はなまる♡",
    "あなたがあなたでいてくれて、うれしいわ〜",
    "よしよし。きょうのあなたも満点よ〜♡"
  ],
  insults: [
    "気持ちが悪い！！！",
    "ミノムシのぺちゃぱいが…",
    "インターネット君",
    "体育祭嫌いそうね",
    "有線のイヤホン使ってそうね",
    "下痢",
    "馬鹿！！！",
    "顔が苦手よ",
    "指が臭いわ",
    "爪の間にゴミたまってるわよ",
    "逆ことね"
  ]
};
</script>
<script>(() => {
  "use strict";
  const normalPath = "data:image/png;base64,";
  const rarePath = "data:image/png;base64,";
  const button = document.getElementById("nui");
  const photo = document.getElementById("photo");
  const message = document.getElementById("message");
  const hint = document.getElementById("hint");
  const { compliments, insults } = window.SENA_LINES;
  const showMessage = (text) => { message.textContent = text.replace(/、/g, "、\n"); };
  let rareReady = false;
  let motion;
  const rare = new Image();
  rare.onload = () => { rareReady = rare.naturalWidth > 0; };
  rare.onerror = () => { rareReady = false; };
  rare.src = rarePath;
  const ready = () => {
    button.disabled = !(photo.naturalWidth > 0 && compliments.length === 30);
    if (button.disabled) {
      message.textContent = "準備中";
      hint.textContent = "写真の登録をお待ちください";
    } else {
      message.textContent = "ぬいをタップしてね ♡";
      hint.textContent = "ぬいをタップしてね ♡";
    }
  };
  photo.onload = ready;
  photo.onerror = () => {
    // レア画像の読み込み失敗時は褒め言葉と通常写真へ戻す。
    if (photo.getAttribute("src") !== normalPath) {
      rareReady = false;
      photo.src = normalPath;
      showMessage(compliments[Math.floor(Math.random() * compliments.length)] || "準備中");
    } else ready();
  };
  button.addEventListener("click", () => {
    if (button.disabled) return;
    const isRare = rareReady && Math.random() < 0.10;
    const lines = isRare ? insults : compliments;
    // onloadでセリフが初期化されないよう、以降は初期化ハンドラを解除する。
    photo.onload = null;
    photo.src = isRare ? rarePath : normalPath;
    showMessage(lines[Math.floor(Math.random() * lines.length)]);
    motion?.cancel();
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      motion = button.animate([
        { transform: "translateY(0)" },
        { transform: "translateY(-14px)", offset: 0.4 },
        { transform: "translateY(0)" }
      ], { duration: 330, easing: "ease-out" });
    }
  });
  ready();
})();
</script>
</html>
